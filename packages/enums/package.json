{
  "name": "enums",
  "version": "0.0.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "precommit": "lint-staged"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "eslint-config": "workspace:*",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "prettier-config": "workspace:*",
    "tsconfig": "workspace:*",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "bash -c 'tsc --noEmit'",
      "prettier --write --config .prettierrc.json"
    ],
    "!*.ts": [
      "prettier --write --config .prettierrc.json"
    ]
  }
}
