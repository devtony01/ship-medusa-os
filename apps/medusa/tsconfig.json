{
  "extends": "tsconfig/medusa.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./.medusa/server",
    "types": ["node", "jest"],
    "paths": {
      "*": ["./src/*"]
    }
  },
  "include": ["**/*", ".medusa/types/*"],
