{
  "extends": "tsconfig/medusa.json",
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "*": ["./src/*"]
    }
  },
  "include": [
    "**/*",
    ".medusa/types/*"
  ],
  "exclude": [
    "node_modules",
    ".medusa/server",
    ".medusa/admin",
    "src/admin",
    ".cache",
    "eslint.config.*"
  ]
}
