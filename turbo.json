{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": ["NODE_ENV"],
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "medusa#build": {
      "dependsOn": ["^build"],
      "outputs": [".medusa/server/**", ".medusa/client/**", "public/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "medusa#dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "precommit": {
      "outputs": []
    }
  }
}
